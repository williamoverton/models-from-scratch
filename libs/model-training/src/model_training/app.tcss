Screen {
    layout: vertical;
}

#dashboard {
    height: 1fr;
    padding: 1 2;
}

#status {
    height: auto;
    margin-bottom: 1;
    color: $accent;
}

.panel {
    height: auto;
    border: round $primary;
    padding: 0 1;
    margin-bottom: 1;
}

#loss-charts {
    height: 14;
}

#loss-charts PlotextPlot {
    width: 1fr;
    height: 100%;
}

#text-generation {
    text-wrap: wrap;
    text-overflow: fold;
}

#training-log {
    height: 1fr;
    min-height: 6;
    border: round $primary;
    padding: 0 1;
}

#image-generation {
    height: 30;
    max-height: 75%;
    margin: 0 2;
}

#preview-caption {
    height: 1;
    color: $text-muted;
}

.preview-images {
    height: 1fr;
}

.preview-row-title {
    height: 1;
    color: $text-muted;
}

.preview-slot {
    width: 1fr;
    height: 1fr;
    align: center top;
}

.preview-slot Static {
    height: 1;
    text-align: center;
}

.preview-slot Image {
    width: auto;
    height: auto;
}
